@page "/leaderboard"
@model CurriculumPortal.LeaderboardModel
@{
  ViewData["BodyClass"] = "leaderboard-layout";
}

@section Head {
  <link rel="stylesheet" href="/css/curriculum.css" asp-append-version="true" />
  <link rel="stylesheet" href="/css/leaderboard.css" asp-append-version="true" />
}

<div class="content-page leaderboard-page">
  <main class="active">
    <header class="leaderboard-header">
      <span class="leaderboard-emblem material-symbols-outlined" aria-hidden="true">emoji_events</span>
      <div>
        <h2 class="course-title">Leaderboard</h2>
        <p>Celebrating our students’ progress, one achievement at a time.</p>
      </div>
    </header>
    @if (Model.Entries.Count == 0)
    {
      <div class="leaderboard-empty">
        <h3>No students have earned XP yet.</h3>
        <p>Students will appear here as they earn XP from assignments and bonus quizzes.</p>
      </div>
    }
    else
    {
      <p class="leaderboard-description" id="leaderboard-description">All students with XP, ordered by total XP. Students with equal XP share a position.</p>
      <div class="leaderboard-scroll" tabindex="0" role="region" aria-label="Student XP leaderboard" aria-describedby="leaderboard-description">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th scope="col" class="numeric">Position</th>
              <th scope="col">Student</th>
              <th scope="col">Tutor group</th>
              <th scope="col" class="numeric">Total XP</th>
              <th scope="col">XP rank</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var entry in Model.Entries)
            {
              var rankImage = $"/images/ranks/{entry.CurrentRank.ToLowerInvariant()}";
              var nextRankText = entry.NextRank is null ? "Maximum rank reached" : $"Next: {entry.NextRank} · {entry.XpToNextRank:N0}\u00a0XP\u00a0to\u00a0go";
              <tr data-position="@entry.Position">
                <td class="leaderboard-position"><span class="leaderboard-place">@entry.Position</span></td>
                <th scope="row">
                  @entry.StudentName
                  <span class="leaderboard-mobile-details">
                    <span>@entry.TutorGroup</span>
                    <span class="leaderboard-rank"><img class="leaderboard-rank-icon" src="@(rankImage)-64.webp" srcset="@(rankImage)-64.webp 64w, @(rankImage)-128.webp 128w" sizes="(max-width: 600px) 20px, 24px" width="20" height="20" alt="" />@entry.CurrentRank</span>
                  </span>
                  <span class="leaderboard-next-rank leaderboard-mobile-next-rank">@nextRankText</span>
                </th>
                <td class="leaderboard-tutor">@entry.TutorGroup</td>
                <td class="numeric"><strong class="leaderboard-xp">@entry.TotalXp.ToString("N0")</strong></td>
                <td>
                  <span class="leaderboard-rank"><img class="leaderboard-rank-icon" src="@(rankImage)-64.webp" srcset="@(rankImage)-64.webp 64w, @(rankImage)-128.webp 128w" sizes="(max-width: 600px) 20px, 24px" width="24" height="24" alt="" />@entry.CurrentRank</span>
                  <span class="leaderboard-next-rank">@nextRankText</span>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </main>
</div>
