@page "/denied"
@using CurriculumPortal
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject AppOptions AppOptions
@{
  ViewData["Title"] = $"Access denied - {AppOptions.SchoolName}";
}

@section Head {
  <link rel="stylesheet" href="/css/curriculum.css" asp-append-version="true" />
}

<div class="content-page">
  <main class="active">
    <h1 class="course-title"><span class="material-symbols-outlined course-title-icon" aria-hidden="true">lock</span> Access denied</h1>
    <p>You do not have permission to view this page.</p>
  </main>
</div>
