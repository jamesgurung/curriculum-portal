@page "/courses/evaluations"
@model CurriculumPortal.CourseEvaluationsModel
@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Course Evaluations</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=block" />
  <link rel="stylesheet" href="/css/layout.css" asp-append-version="true" />
  <link rel="stylesheet" href="/css/curriculum.css" asp-append-version="true" />
  <style>
    @@page {
      size: A4 portrait;
      margin: 15mm;
    }

    .evaluation-collection {
      font-size: 11pt;
      max-width: none;
      margin: 0;
      text-align: justify;
      text-align-last: left;
    }

    .evaluation-collection .evaluation-rating-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem 1.5rem;
    }

    .evaluation-collection .evaluation-rating-item {
      flex: 0 0 auto;
      width: auto;
      min-width: 0;
      min-height: 0;
      padding: 0.2rem 0;
      border: 0;
      background: transparent;
      white-space: nowrap;
    }

    .evaluation-collection .evaluation-rating-item span:first-child {
      min-width: 2ch;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    body.evaluation-layout {
      display: block;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .evaluation-collection .evaluation-report + .evaluation-report {
      break-before: right;
    }

    .evaluation-collection .evaluation-unit[data-split-from] {
      border-top: 0;
    }

    .evaluation-collection .evaluation-header,
    .evaluation-collection .evaluation-section-header,
    .evaluation-collection .evaluation-criterion-header,
    .evaluation-collection h2,
    .evaluation-collection h3,
    .evaluation-collection h4,
    .evaluation-collection h5 {
      break-after: avoid-page;
      page-break-after: avoid;
    }

    .evaluation-collection ul,
    .evaluation-collection .evaluation-criterion > h5 {
      break-before: avoid-page;
      page-break-before: avoid;
    }

    .evaluation-collection li,
    .evaluation-collection .evaluation-rating-item {
      break-inside: avoid-page;
      page-break-inside: avoid;
    }

    .evaluation-collection,
    .evaluation-collection * {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  </style>
</head>
<body class="evaluation-layout">

<main class="evaluation-main evaluation-collection active">
  @if (Model.Reports.Count == 0)
  {
    <section class="evaluation-empty">
      <span class="material-symbols-outlined" aria-hidden="true">draft</span>
      <h2>No course evaluations are available.</h2>
    </section>
  }
  else
  {
    @foreach (var report in Model.Reports)
    {
      <partial name="_CourseEvaluationReport" model="report" />
    }
  }
</main>

<script>
  window.PagedConfig = {
    auto: false
  };
</script>
<script src="/lib/pagedjs/dist/paged.polyfill.js"></script>
<script>
  window.addEventListener('load', async () => {
    try {
      await document.fonts.ready;
      await window.PagedPolyfill.preview();
      window.print();
    } catch (error) {
      console.error('The evaluation print layout could not be prepared.', error);
    }
  }, { once: true });
</script>
</body>
</html>
