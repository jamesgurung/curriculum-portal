@page "/courses/{courseId?}/{unitId?}/{action?}"
@model CurriculumPortal.CoursesModel
@using System.Text
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@{
  ViewData["Title"] = Model.PageTitle;
  ViewData["MetaDescription"] = Model.MetaDescription;
  ViewData["CanonicalUrl"] = Model.CanonicalUrl;
  ViewData["Robots"] = Model.IsQuiz ? "noindex, follow" : null;
  ViewData["BodyClass"] = "courses-layout";

  string RenderKnowledgeItem(string value)
  {
    var content = value ?? string.Empty;
    var result = new StringBuilder();
    var cursor = 0;
    foreach (Match match in Regex.Matches(content, @"\[img:(\d+)\]"))
    {
      result.Append(HtmlEncoder.Default.Encode(content[cursor..match.Index]));
      var image = Model.KeyKnowledge?.Images?.FirstOrDefault(item => item.Index.ToString() == match.Groups[1].Value);
      if (image is not null)
      {
        result.Append("<img alt=\"Exemplification\" src=\"")
          .Append(HtmlEncoder.Default.Encode(image.Content))
          .Append("\" style=\"width:")
          .Append(image.Width * 2)
          .Append("mm;vertical-align:middle\" />");
      }
      cursor = match.Index + match.Length;
    }
    result.Append(HtmlEncoder.Default.Encode(content[cursor..]));
    return result.ToString();
  }
}

@section Head {
  <link rel="stylesheet" href="/css/curriculum.css" asp-append-version="true" />
}

<div id="curriculum-app">
  <aside id="course-column" class="@(Model.ServerRender && Model.SelectedCourse is not null && !Model.IsQuiz ? string.Empty : "active")" tabindex="0" aria-label="Course list">
    <ul id="course-list">
      @if (Model.ServerRender)
      {
        @foreach (var course in Model.PublicCourses)
        {
          <li class="course-item @(course == Model.SelectedCourse ? "active" : string.Empty)" data-course-id="@course.RowKey">
            <a href="/courses/@Uri.EscapeDataString(course.RowKey)">
              <span class="material-symbols-outlined">@(string.IsNullOrWhiteSpace(course.Icon) ? "book" : course.Icon)</span><span class="course-name">@course.Name</span>
            </a>
          </li>
        }
      }
    </ul>
  </aside>
  <main class="@(Model.ServerRender && Model.SelectedCourse is not null && !Model.IsQuiz ? "active" : string.Empty)">
    <div id="course-detail" class="@(Model.ServerRender && Model.SelectedCourse is not null && Model.SelectedUnit is null && !Model.IsQuiz ? "active" : string.Empty)">
      @if (Model.ServerRender && Model.SelectedCourse is not null && Model.SelectedUnit is null && !Model.IsQuiz)
      {
        var courseUnits = Model.PublicUnits.Where(unit => unit.CourseId == Model.SelectedCourse.RowKey).ToList();
        <h2 class="course-title">
          <a class="back-button material-symbols-outlined" data-action="back-course" href="/courses" aria-label="Back to courses">arrow_back</a>
          <span>@Model.SelectedCourse.Name</span>
        </h2>
        <p class="course-info">
          <b><span class="material-symbols-outlined icon">badge</span><span class="label">@(Model.SelectedCourse.LeaderNames?.Contains(',') == true ? "Course leaders" : "Course leader")</span></b>
          <span class="value">@Model.SelectedCourse.LeaderNames</span>
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCourse.Specification) && !Model.SelectedCourse.Name.StartsWith("KS"))
        {
          <p class="course-info">
            <b><span class="material-symbols-outlined icon">book_5</span><span class="label">Specification</span></b>
            <span class="value specification-content">@Model.SelectedCourse.Specification</span>
          </p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCourse.Intent))
        {
          <p class="course-info">
            <b><span class="material-symbols-outlined icon">target</span><span class="label">Curriculum intent</span></b>
            <span class="value intent-content">@Model.SelectedCourse.Intent</span>
          </p>
        }
        @foreach (var year in courseUnits.Select(unit => unit.YearGroup).Distinct())
        {
          <div class="year-group-section">
            <b class="year-group-heading"><span class="material-symbols-outlined">stacks</span><span class="year-title">Year @year units</span></b>
            <ul class="units-list">
              @foreach (var unit in courseUnits.Where(unit => unit.YearGroup == year))
              {
                <li class="unit-item" data-id="@unit.Id">
                  <a href="/courses/@Uri.EscapeDataString(Model.SelectedCourse.RowKey)/@Uri.EscapeDataString(unit.Id)">
                    <span class="material-symbols-outlined">assignment</span><span><strong class="unit-title">@unit.Title</strong><span class="term-text">@($"Year {unit.YearGroup} {(string.IsNullOrWhiteSpace(unit.Term) ? string.Empty : $"{unit.Term} Term")}")</span></span>
                  </a>
                </li>
              }
            </ul>
          </div>
        }
        @if (courseUnits.Count == 0 && string.IsNullOrWhiteSpace(Model.SelectedCourse.Specification) && string.IsNullOrWhiteSpace(Model.SelectedCourse.Intent))
        {
          <p class="course-info">There is not yet any information about this course.</p>
        }
      }
      else
      {
        <p class="course-placeholder">Select a course.</p>
      }
    </div>
    <div id="unit-detail" class="@(Model.ServerRender && Model.SelectedUnit is not null && !Model.IsQuiz ? "active" : string.Empty)">
      @if (Model.ServerRender && Model.SelectedUnit is not null && !Model.IsQuiz)
      {
        <div class="unit-header">
          <a class="back-button material-symbols-outlined" data-action="back-to-course" href="/courses/@Uri.EscapeDataString(Model.SelectedCourse.RowKey)" aria-label="Back to course">arrow_back</a>
          <h2 class="unit-title">@Model.SelectedUnit.Title</h2>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SelectedUnit.WhyThis) || !string.IsNullOrWhiteSpace(Model.SelectedUnit.WhyNow))
        {
          <div class="unit-rationale">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedUnit.WhyThis))
            {
              <p class="why-this"><span class="material-symbols-outlined">info</span><span><strong>Why this?</strong> <span class="text">@Model.SelectedUnit.WhyThis</span></span></p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SelectedUnit.WhyNow))
            {
              <p class="why-now"><span class="material-symbols-outlined">schedule</span><span><strong>Why now?</strong> <span class="text">@Model.SelectedUnit.WhyNow</span></span></p>
            }
          </div>
        }
        @if (Model.KeyKnowledge is not null)
        {
          <div class="key-knowledge">
            <div id="declarative-header-container"><h3><span class="material-symbols-outlined">neurology</span>You need to know</h3></div>
            <div id="declarative-knowledge">
              @if (Model.KeyKnowledge.DeclarativeKnowledge?.Count > 0)
              {
                <ul class="key-knowledge-list">
                  @foreach (var item in Model.KeyKnowledge.DeclarativeKnowledge)
                  {
                    <li>@Html.Raw(RenderKnowledgeItem(item))</li>
                  }
                </ul>
              }
            </div>
            <h3><span class="material-symbols-outlined">rocket_launch</span>You must be able to</h3>
            <div id="procedural-knowledge">
              @if (Model.KeyKnowledge.ProceduralKnowledge?.Count > 0)
              {
                <ul class="key-knowledge-list">
                  @foreach (var item in Model.KeyKnowledge.ProceduralKnowledge)
                  {
                    <li>@Html.Raw(RenderKnowledgeItem(item))</li>
                  }
                </ul>
              }
            </div>
          </div>
        }
        @if (string.IsNullOrWhiteSpace(Model.SelectedUnit.WhyThis) && string.IsNullOrWhiteSpace(Model.SelectedUnit.WhyNow) && Model.KeyKnowledge is null)
        {
          <p class="course-info">There is not yet any information about this unit.</p>
        }
      }
    </div>
    <div id="unit-quiz">
      <button id="quiz-back" class="back-button material-symbols-outlined">arrow_back</button>
      <div class="quiz-shell">
        <h2><span id="quiz-title"></span><br />Revision Quiz</h2>
        <div id="quiz-play">
          <div id="progress-container"><div id="progress"></div></div>
          <div id="question"></div>
          <div class="answers">
            <button id="answer1"></button>
            <button id="answer2"></button>
          </div>
          <div id="outcome"></div>
        </div>
        <div id="quiz-result" class="hide">
          <span class="material-symbols-outlined">trophy</span>
          <span class="congratulations">Congratulations! You have completed the quiz.</span>
          <button id="quiz-restart">Restart</button>
        </div>
      </div>
    </div>
  </main>
</div>

<div id="modal">
  <div id="modal-content">
    <div id="modal-header">
      <h2 id="modal-title"></h2>
      <button id="modal-close" class="material-symbols-outlined" aria-label="Close modal">close</button>
    </div>
    <div id="modal-body">
      <p id="modal-body-question"></p>
      <div id="modal-text-container">
        <p id="modal-body-example" class="grey"></p>
        <textarea id="modal-text"></textarea>
      </div>
      <div id="modal-select-container">
        <select id="modal-select">
          <option value="Autumn">Autumn</option>
          <option value="Spring">Spring</option>
          <option value="Summer">Summer</option>
        </select>
      </div>
      <div id="modal-checklist-container" class="hide"></div>
    </div>
    <div id="modal-footer">
      <button id="modal-save" class="btn">Save</button>
    </div>
  </div>
</div>

<div id="ai-modal" class="evaluation-modal" role="dialog" aria-modal="true" aria-labelledby="ai-modal-title" aria-describedby="ai-modal-note" tabindex="-1">
  <div class="modal-content">
    <div class="modal-body">
      <h2 id="ai-modal-title"><span class="spinner" aria-hidden="true"></span><span>Enhancing unit rationales...</span></h2>
      <p id="ai-modal-note" class="evaluation-progress-note">This may take several minutes. Do not close the page.</p>
    </div>
  </div>
</div>

<div id="csrf"><input type="hidden" name="__RequestVerificationToken" value="@Model.CsrfToken" /></div>

<template id="tpl-course-item">
  <li class="course-item" data-course-id="">
    <a href="">
      <span class="material-symbols-outlined">book</span><span class="course-name"></span>
    </a>
  </li>
</template>

<template id="tpl-course-placeholder">
  <p class="course-placeholder">Select a course.</p>
</template>

<template id="tpl-back-course">
  <a class="back-button material-symbols-outlined" data-action="back-course" href="/courses" aria-label="Back to courses">arrow_back</a>
</template>

<template id="tpl-course-title">
  <h2 class="course-title"></h2>
</template>

<template id="tpl-course-info">
  <p class="course-info">
    <b><span class="material-symbols-outlined icon"></span><span class="label"></span></b> <span class="value"></span>
  </p>
</template>

<template id="tpl-no-course-info">
  <p class="course-info">There is not yet any information about this course.</p>
</template>

<template id="tpl-year-group-section">
  <div class="year-group-section">
    <b class="year-group-heading"><span class="material-symbols-outlined">stacks</span><span class="year-title"></span></b>
    <ul class="units-list"></ul>
    <div class="no-units hide">No units configured</div>
  </div>
</template>

<template id="tpl-unit-item">
  <li class="unit-item" data-id="">
    <a href="">
      <span class="material-symbols-outlined">assignment</span><span><strong class="unit-title"></strong><span class="term-text"></span></span>
    </a>
  </li>
</template>

<template id="tpl-unit-header">
  <div class="unit-header">
    <a class="back-button material-symbols-outlined" data-action="back-to-course" href="" aria-label="Back to course">arrow_back</a>
    <h2 class="unit-title"></h2>
  </div>
</template>

<template id="tpl-unit-rationale">
  <div class="unit-rationale">
    <p class="why-this hide"><span class="material-symbols-outlined">info</span><span><strong>Why this?</strong> <span class="text"></span></span></p>
    <p class="why-now hide"><span class="material-symbols-outlined">schedule</span><span><strong>Why now?</strong> <span class="text"></span></span></p>
  </div>
</template>

<template id="tpl-key-knowledge">
  <div class="key-knowledge">
    <div id="declarative-header-container"><h3><span class="material-symbols-outlined">neurology</span>You need to know</h3></div>
    <div id="declarative-knowledge"><div class="loading">Loading...</div></div>
    <h3><span class="material-symbols-outlined">rocket_launch</span>You must be able to</h3>
    <div id="procedural-knowledge"><div class="loading">Loading...</div></div>
  </div>
</template>

<template id="tpl-no-unit-info">
  <p class="course-info">There is not yet any information about this unit.</p>
</template>

<template id="tpl-outcome">
  <span>
    <span class="material-symbols-outlined"></span><span class="outcome-text"></span>
  </span>
</template>

@section Scripts {
  <script>
    const courses = @Html.Raw(Model.CoursesJson);
    const units = @Html.Raw(Model.UnitsJson);
    const editableCourseIds = @Html.Raw(Model.EditableCourseIdsJson);
    const isAdmin = @Html.Raw(Model.IsAdminJson);
    const checklistItems = @Html.Raw(Model.ChecklistItemsJson);
    const isStaff = @(Model.IsStaff ? "true" : "false");
    const isEditableStaff = @(Model.IsEditableStaff ? "true" : "false");
    const microsoftSharePointSubdomain = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MicrosoftSharePointSubdomain));
    const csrfToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CsrfToken));
    window.MathJax = {
      tex: { inlineMath: [['`', '`'], ['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']] },
      output: {
        displayOverflow: 'scroll',
        font: 'mathjax-newcm',
        fontPath: `${location.origin}/lib/mathjax-newcm-font`
      },
      options: {
        worker: {
          path: `${location.origin}/lib/mathjax/sre`,
          maps: `${location.origin}/lib/mathjax/sre/mathmaps`,
          worker: 'speech-worker.js'
        }
      }
    };
  </script>
  <script src="/lib/mathjax/tex-chtml.min.js"></script>
  <script src="/lib/sortablejs/Sortable.min.js"></script>
  <script src="/js/curriculum-home.js"></script>
}
