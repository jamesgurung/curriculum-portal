@page "/followup"
@using CurriculumPortal
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.Admin)]
@model FollowupModel
@{
  ViewData["Title"] = "Curriculum Follow-Up";
}

<style>
  @@page {
    size: A4 portrait;
    margin: 8mm;
  }

  .followup-page {
    box-sizing: border-box;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 24px 16px;
    font-family: Arial, sans-serif;
    font-size: 9pt;
    color: #202124;
  }

  .followup-page * {
    box-sizing: border-box;
    margin: 0;
  }

  .followup-department {
    margin: 0;
    padding: 0;
    break-after: page;
    page-break-after: always;
  }

  .followup-department:last-child {
    break-after: auto;
    page-break-after: auto;
  }

  .followup-page-title {
    font-size: 22px;
    margin-bottom: 24px;
  }

  .followup-title {
    break-after: avoid;
    font-size: 18px;
    margin-bottom: 16px;
    page-break-after: avoid;
  }

  .followup-course {
    margin-bottom: 24px;
  }

  .followup-course:last-child {
    margin-bottom: 0;
  }

  .followup-course-title {
    break-after: avoid;
    font-size: 14px;
    margin-bottom: 8px;
    page-break-after: avoid;
  }

  .followup-table-wrapper {
    break-before: avoid;
    overflow-x: auto;
    page-break-before: avoid;
  }

  .followup-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    table-layout: fixed;
    margin: 0;
  }

  .followup-table th,
  .followup-table td {
    border: 1px solid #dadce0;
    padding: 3px 0;
    vertical-align: middle;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .followup-table th {
    background: #f8f9fa;
  }

  .followup-table thead th {
    vertical-align: bottom;
  }

  .followup-row-heading {
    padding-left: 6px !important;
    padding-right: 6px !important;
    width: 28%;
    text-align: left;
  }

  .followup-table tbody .followup-row-heading {
    font-weight: normal;
    overflow: hidden;
    overflow-wrap: normal;
    text-overflow: ellipsis;
    white-space: nowrap;
    word-break: normal;
  }

  .followup-criterion-heading {
    padding: 0 !important;
    text-align: center;
    vertical-align: bottom !important;
  }

  .followup-criterion-heading-content {
    align-items: flex-end;
    display: flex;
    height: 190px;
    justify-content: center;
    padding-bottom: 3px;
  }

  .followup-criterion-heading-text {
    display: inline-block;
    height: 100%;
    line-height: 1.15;
    text-align: start;
    transform: rotate(180deg);
    writing-mode: vertical-rl;
  }

  .followup-status {
    text-align: center;
    white-space: nowrap;
  }

  .followup-status-symbol {
    font-size: 14px;
    font-weight: bold;
  }

  .followup-status-complete {
    color: #137333;
  }

  .followup-status-incomplete {
    color: #b3261e;
  }

  .followup-status-secondary {
    color: #bdc1c6;
  }

  .followup-status-count {
    color: #bdc1c6;
    font-weight: normal;
  }

  .followup-not-applicable {
    color: #bdc1c6;
  }

  .followup-no-units {
    font-weight: bold;
    text-align: left;
  }

  @@media screen {
    .followup-department + .followup-department {
      margin-top: 32px;
    }
  }

  @@media print {
    .app-header,
    .app-footer,
    .followup-page-title {
      display: none !important;
    }

    body {
      display: block;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .app-body {
      display: block;
    }

    .followup-page {
      max-width: none;
      padding: 0;
      width: 100%;
      font-size: 8pt;
    }

    .followup-table-wrapper {
      overflow: visible;
    }

    .followup-table {
      min-width: 0;
      width: 100%;
    }

    .followup-table th,
    .followup-table td {
      padding: 0;
    }

    .followup-table col:first-child {
      width: 22% !important;
    }

    .followup-row-heading {
      padding-left: 1px !important;
      padding-right: 1px !important;
    }

    .followup-table thead {
      break-after: avoid-page;
      display: table-header-group;
      page-break-after: avoid;
    }

    .followup-table tbody tr:first-child {
      break-before: avoid-page;
      page-break-before: avoid;
    }

    .followup-table tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .followup-title,
    .followup-course-title {
      break-after: avoid-page;
      page-break-after: avoid;
    }

    .followup-criterion-heading {
      padding: 0 !important;
      font-size: 7pt;
    }

    .followup-criterion-heading-content {
      height: 52mm;
      padding-bottom: 0;
    }

    .followup-status-symbol {
      font-size: 12px;
    }

    .followup-page,
    .followup-page * {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }

</style>

<main class="followup-page">
  <h1 class="followup-page-title">Curriculum Follow-Up</h1>

  @if (Model.Departments.Count == 0)
  {
    <text>No course summaries could be generated.</text>
  }

  @foreach (var department in Model.Departments)
  {
    <section class="followup-department">
      <h2 class="followup-title">Head of Department: @department.Name</h2>

      @foreach (var course in department.Courses)
      {
        <section class="followup-course">
          <h3 class="followup-course-title">@course.Name</h3>
          <div class="followup-table-wrapper">
            <table class="followup-table">
              <colgroup>
                <col style="width: 28%">
                @foreach (var criterion in course.Criteria)
                {
                  <col>
                }
              </colgroup>
              <thead>
                <tr>
                  <th class="followup-row-heading" scope="col">Unit</th>
                  @foreach (var criterion in course.Criteria)
                  {
                    <th class="followup-criterion-heading" scope="col">
                      <span class="followup-criterion-heading-content">
                        <span class="followup-criterion-heading-text">@criterion.Name</span>
                      </span>
                    </th>
                  }
                </tr>
              </thead>
              <tbody>
                @foreach (var row in course.Rows)
                {
                  <tr>
                    <th class="followup-row-heading" scope="row" title="@row.Name">@row.Name</th>
                    @foreach (var cell in row.Cells)
                    {
                      <td class="followup-status">
                        @if (!cell.Applicable)
                        {
                          <span class="followup-not-applicable" aria-label="Not applicable">&mdash;</span>
                        }
                        else if (cell.Complete)
                        {
                          <span class="followup-status-symbol followup-status-complete" aria-label="Complete">&#x2705;</span>
                        }
                        else
                        {
                          <span class="followup-status-symbol @(cell.Important ? "followup-status-incomplete" : "followup-status-secondary")" aria-label="Incomplete">
                            @if (cell.Important){<text>&#x274C;</text>}else{<text>&#x2715;</text>}@if (cell.Count > 0){<span class="followup-status-count">&nbsp;@cell.Count</span>}
                          </span>
                        }
                      </td>
                    }
                  </tr>
                }
                @if (!course.HasUnits)
                {
                  <tr>
                    <td class="followup-no-units" colspan="@(course.Criteria.Count + 1)">
                      <span class="followup-status-symbol followup-status-incomplete" aria-label="Compulsory item incomplete">&#x274C;</span>
                      No units configured
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </section>
      }
    </section>
  }
</main>
