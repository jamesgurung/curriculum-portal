@page "/courses/{courseId}/evaluation"
@model CurriculumPortal.CourseEvaluationModel
@using CurriculumPortal
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@{
  ViewData["Title"] = $"{Model.Course.Name} Evaluation";
  ViewData["BodyClass"] = "evaluation-layout";
}

@functions {
  static IEnumerable<CourseEvaluationRecommendedAction> Clean(IEnumerable<CourseEvaluationRecommendedAction> items) =>
    (items ?? Enumerable.Empty<CourseEvaluationRecommendedAction>()).Where(o => !string.IsNullOrWhiteSpace(o.Action));

  static bool HasItems(IEnumerable<CourseEvaluationRecommendedAction> items) => Clean(items).Any();

  static string PriorityText(int priority) => priority switch
  {
    1 => "Priority",
    2 => "Essential",
    3 => "Recommended",
    4 => "Suggested",
    _ => "None"
  };
}

@section Head {
  <link rel="stylesheet" href="/css/curriculum.css" />
}

<main class="evaluation-main active">
    <div class="evaluation-header">
      <a class="back-button" href="/courses/@Uri.EscapeDataString(Model.CourseId)" title="Back to course" aria-label="Back to course">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      </a>
      <div class="evaluation-heading">
        <span class="evaluation-kicker">Course evaluation</span>
        <h2>@Model.Course.Name</h2>
        @if (Model.Evaluation is not null)
        {
          <p>Feedback generated on @Model.GeneratedAtText</p>
        }
      </div>
      @if (Model.IsAdmin)
      {
        <button id="evaluate-course" class="evaluation-action">
          <span class="material-symbols-outlined">emoji_objects</span>
          <span>Evaluate this course</span>
        </button>
      }
    </div>

    @if (Model.Evaluation is null)
    {
      <section class="evaluation-empty">
        <span class="material-symbols-outlined">draft</span>
        <h3>No evaluation is available.</h3>
        <p>Run an evaluation to generate feedback on the quality of this course.</p>
      </section>
    }
    else
    {
      var priorities = new[] { 1, 2, 3, 4 };
      var priorityCounts = priorities.ToDictionary(p => p, _ => 0);
      var evaluationActions = Clean(Model.Evaluation.Overall.SequencingRecommendedActions)
        .Concat(Clean(Model.Evaluation.Overall.CoverageBalanceRecommendedActions))
        .Concat(Clean(Model.Evaluation.Overall.AssessmentRecapRecommendedActions))
        .Concat(Model.Evaluation.Units.SelectMany(unit =>
          Clean(unit.KeyKnowledge.RecommendedActions)
            .Concat(Clean(unit.Assessment.AlignmentRecommendedActions))
            .Concat(Clean(unit.Assessment.DesignRecommendedActions))));

      foreach (var priority in evaluationActions.Select(o => o.Priority).Where(priority => priorityCounts.ContainsKey(priority)))
      {
        priorityCounts[priority]++;
      }

      <section class="evaluation-summary-section">
        <div class="evaluation-section-header">
          <h3>Summary</h3>
        </div>
        <p class="evaluation-summary">These actions have been suggested by AI to support ongoing curriculum development work. Use your own judgement when reviewing the feedback.</p>
        <div class="evaluation-rating-summary">
          @foreach (var priority in priorities)
          {
            <button type="button" class="evaluation-rating-box" data-priority="@priority" aria-pressed="false">
              <span>@priorityCounts[priority]</span>
              <span aria-hidden="true">&times;</span>
              <span class="evaluation-rating action-priority-@priority" role="img" aria-label="@PriorityText(priority)"></span>
              <span>@PriorityText(priority)</span>
            </button>
          }
        </div>
      </section>

      <section class="evaluation-overview">
        <div class="evaluation-section-header">
          <h3>Curriculum Overview</h3>
          <button type="button" class="evaluation-section-action" data-evaluation-url="/courses/@Uri.EscapeDataString(Model.CourseId)/evaluate/overview" data-evaluation-label="the curriculum overview" data-evaluation-title="curriculum overview">
            <span class="material-symbols-outlined">refresh</span>
            <span>Re-evaluate overview</span>
          </button>
        </div>
        <div class="evaluation-grid">
          <article class="evaluation-panel">
            <div class="evaluation-title-row">
              <h4>Coverage and balance</h4>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Evaluation.Overall.CoverageBalanceOverview))
            {
              <h5>Overview</h5>
              <p>@Model.Evaluation.Overall.CoverageBalanceOverview</p>
            }
            @if (HasItems(Model.Evaluation.Overall.CoverageBalanceRecommendedActions))
            {
              <h5>Next steps</h5>
              <ul>
                @foreach (var item in Clean(Model.Evaluation.Overall.CoverageBalanceRecommendedActions))
                {
                  <li data-priority="@item.Priority"><span class="evaluation-action-priority action-priority-@item.Priority" role="img" aria-label="@PriorityText(item.Priority)"></span><span>@item.Action</span></li>
                }
              </ul>
            }
          </article>
          <article class="evaluation-panel">
            <div class="evaluation-title-row">
              <h4>Sequencing</h4>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Evaluation.Overall.SequencingOverview))
            {
              <h5>Overview</h5>
              <p>@Model.Evaluation.Overall.SequencingOverview</p>
            }
            @if (HasItems(Model.Evaluation.Overall.SequencingRecommendedActions))
            {
              <h5>Next steps</h5>
              <ul>
                @foreach (var item in Clean(Model.Evaluation.Overall.SequencingRecommendedActions))
                {
                  <li data-priority="@item.Priority"><span class="evaluation-action-priority action-priority-@item.Priority" role="img" aria-label="@PriorityText(item.Priority)"></span><span>@item.Action</span></li>
                }
              </ul>
            }
          </article>
          <article class="evaluation-panel">
            <div class="evaluation-title-row">
              <h4>Assessment recap questions</h4>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Evaluation.Overall.AssessmentRecapOverview))
            {
              <h5>Overview</h5>
              <p>@Model.Evaluation.Overall.AssessmentRecapOverview</p>
            }
            @if (HasItems(Model.Evaluation.Overall.AssessmentRecapRecommendedActions))
            {
              <h5>Next steps</h5>
              <ul>
                @foreach (var item in Clean(Model.Evaluation.Overall.AssessmentRecapRecommendedActions))
                {
                  <li data-priority="@item.Priority"><span class="evaluation-action-priority action-priority-@item.Priority" role="img" aria-label="@PriorityText(item.Priority)"></span><span>@item.Action</span></li>
                }
              </ul>
            }
          </article>
        </div>
      </section>

      <div class="evaluation-units">
        @for (var unitIndex = 0; unitIndex < Model.Evaluation.Units.Count; unitIndex++)
        {
          var unit = Model.Evaluation.Units[unitIndex];
          var currentUnit = Model.Units.ElementAtOrDefault(unitIndex);
          var unitId = !string.IsNullOrWhiteSpace(unit.UnitId) ? unit.UnitId : currentUnit?.RowKey;

          <section class="evaluation-unit">
            <div class="evaluation-section-header evaluation-unit-header">
              <h3>@unit.Title</h3>
              @if (!string.IsNullOrWhiteSpace(unitId))
              {
                <button type="button" class="evaluation-section-action" data-evaluation-url="/courses/@Uri.EscapeDataString(Model.CourseId)/evaluate/units/@Uri.EscapeDataString(unitId)" data-evaluation-label="@unit.Title">
                  <span class="material-symbols-outlined">refresh</span>
                  <span>Re-evaluate unit</span>
                </button>
              }
            </div>
            <div class="evaluation-criteria">
              <article class="evaluation-criterion">
                <div class="evaluation-criterion-header">
                  <div class="evaluation-title-row">
                    <h4>Key knowledge</h4>
                  </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(unit.KeyKnowledge.Overview))
                {
                  <h5>Overview</h5>
                  <p>@unit.KeyKnowledge.Overview</p>
                }
                @if (HasItems(unit.KeyKnowledge.RecommendedActions))
                {
                  <h5>Next steps</h5>
                  <ul>
                    @foreach (var item in Clean(unit.KeyKnowledge.RecommendedActions))
                    {
                      <li data-priority="@item.Priority"><span class="evaluation-action-priority action-priority-@item.Priority" role="img" aria-label="@PriorityText(item.Priority)"></span><span>@item.Action</span></li>
                    }
                  </ul>
                }
              </article>

              <article class="evaluation-criterion">
                <div class="evaluation-criterion-header">
                  <div class="evaluation-title-row">
                    <h4>Assessment</h4>
                  </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(unit.Assessment.Overview))
                {
                  <h5>Overview</h5>
                  <p>@unit.Assessment.Overview</p>
                }
                @if (HasItems(unit.Assessment.AlignmentRecommendedActions))
                {
                  <h5>Next steps for alignment</h5>
                  <ul>
                    @foreach (var item in Clean(unit.Assessment.AlignmentRecommendedActions))
                    {
                      <li data-priority="@item.Priority"><span class="evaluation-action-priority action-priority-@item.Priority" role="img" aria-label="@PriorityText(item.Priority)"></span><span>@item.Action</span></li>
                    }
                  </ul>
                }
                @if (HasItems(unit.Assessment.DesignRecommendedActions))
                {
                  <h5>Next steps for design</h5>
                  <ul>
                    @foreach (var item in Clean(unit.Assessment.DesignRecommendedActions))
                    {
                      <li data-priority="@item.Priority"><span class="evaluation-action-priority action-priority-@item.Priority" role="img" aria-label="@PriorityText(item.Priority)"></span><span>@item.Action</span></li>
                    }
                  </ul>
                }
              </article>
            </div>
          </section>
        }
      </div>
    }
</main>

<div id="modal" class="evaluation-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div id="modal-content">
    <div id="modal-body">
      <h2 id="modal-title"><span class="spinner"></span><span id="modal-title-text">Evaluating the course...</span></h2>
      <p class="evaluation-progress-note">This may take several minutes. Do not close the page.</p>
      <div class="evaluation-progress-track" role="progressbar" aria-label="Evaluation progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="evaluation-progress-bar"></div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    const courseId = @Html.Raw(JsonSerializer.Serialize(Model.CourseId));
    const csrfToken = @Html.Raw(JsonSerializer.Serialize(Model.CsrfToken));
    const elements = {
      evaluate: document.getElementById('evaluate-course'),
      modal: document.getElementById('modal'),
      modalTitleText: document.getElementById('modal-title-text'),
      progressTrack: document.querySelector('.evaluation-progress-track'),
      progressBar: document.getElementById('evaluation-progress-bar'),
      evaluationButtons: [...document.querySelectorAll('#evaluate-course, .evaluation-section-action')],
      sectionActions: [...document.querySelectorAll('.evaluation-section-action')],
      ratingBoxes: [...document.querySelectorAll('.evaluation-rating-box')],
      filterActions: [...document.querySelectorAll('li[data-priority]')],
      filterLists: [...document.querySelectorAll('.evaluation-panel ul, .evaluation-criterion ul')],
      filterItems: [...document.querySelectorAll('.evaluation-panel, .evaluation-criterion')],
      filterParents: [...document.querySelectorAll('.evaluation-overview, .evaluation-unit')]
    };
    const selectedPriorities = new Set();

    elements.evaluate?.addEventListener('click', evaluateCourse);
    elements.sectionActions.forEach(button => button.addEventListener('click', () => evaluateSection(button)));
    elements.ratingBoxes.forEach(box => box.addEventListener('click', () => filterPriority(box.dataset.priority)));

    function filterPriority(priority) {
      if (selectedPriorities.has(priority)) {
        selectedPriorities.delete(priority);
      } else {
        selectedPriorities.add(priority);
      }

      elements.ratingBoxes.forEach(box => {
        const selected = selectedPriorities.has(box.dataset.priority);
        box.classList.toggle('selected', selected);
        box.setAttribute('aria-pressed', String(selected));
      });

      const filtersActive = selectedPriorities.size > 0;

      elements.filterActions.forEach(item => {
        item.classList.toggle('evaluation-filter-hidden', filtersActive && !selectedPriorities.has(item.dataset.priority));
      });

      elements.filterLists.forEach(list => {
        const visibleAction = list.querySelector('li[data-priority]:not(.evaluation-filter-hidden)');
        const hidden = filtersActive && !visibleAction;
        list.classList.toggle('evaluation-filter-hidden', hidden);
        if (list.previousElementSibling?.tagName === 'H5') {
          list.previousElementSibling.classList.toggle('evaluation-filter-hidden', hidden);
        }
      });

      elements.filterItems.forEach(item => {
        const visibleAction = item.querySelector('li[data-priority]:not(.evaluation-filter-hidden)');
        item.classList.toggle('evaluation-filter-hidden', filtersActive && !visibleAction);
      });

      elements.filterParents.forEach(parent => {
        const visibleItem = parent.querySelector('.evaluation-panel:not(.evaluation-filter-hidden), .evaluation-criterion:not(.evaluation-filter-hidden)');
        parent.classList.toggle('evaluation-filter-hidden', filtersActive && !visibleItem);
      });
    }

    function setProgress(percentage) {
      const value = Math.max(0, Math.min(Number(percentage) || 0, 100));
      elements.progressBar.style.width = `${value}%`;
      elements.progressTrack.setAttribute('aria-valuenow', String(value));
    }

    function setEvaluationButtonsDisabled(disabled) {
      elements.evaluationButtons.forEach(button => button.disabled = disabled);
    }

    async function evaluateCourse() {
      if (!window.confirm('Are you sure you want to run the evaluation? This may take several minutes.')) return;

      await runEvaluation(`/courses/${encodeURIComponent(courseId)}/evaluate`, 'Evaluating the course...');
    }

    async function evaluateSection(button) {
      const label = button.dataset.evaluationLabel || 'this section';
      if (!window.confirm(`Are you sure you want to re-evaluate ${label}? This may take several minutes.`)) return;

      const title = button.dataset.evaluationTitle || label;
      await runEvaluation(button.dataset.evaluationUrl, `Re-evaluating ${title}...`);
    }

    async function runEvaluation(url, title) {
      setEvaluationButtonsDisabled(true);
      setProgress(0);
      elements.modalTitleText.textContent = title;
      elements.modal.classList.add('active');

      try {
        await postSse(url, progress => {
          setProgress(progress.percentage ?? 0);
        });
        setProgress(100);
        window.location.reload();
      } catch (error) {
        const message = error.message || 'The evaluation failed.';
        elements.modal.classList.remove('active');
        window.alert(message);
        setEvaluationButtonsDisabled(false);
      }
    }

    async function postSse(url, onProgress) {
      if (!csrfToken) {
        throw new Error('Missing anti-forgery token.');
      }

      const response = await fetch(url, {
        method: 'POST',
        headers: { 'X-CSRF-TOKEN': csrfToken }
      });
      if (!response.ok) throw new Error(await readAiError(response, 'The evaluation failed.'));
      if (!response.body) throw new Error('No response stream received.');

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      async function readAiError(response, fallback) {
        const message = (await response.text()).trim();
        if (response.status === 429) return message || 'The daily AI token limit has been reached. Please try again later.';
        return message || fallback;
      }

      function readEvent(frame) {
        let event = 'message';
        const data = [];
        frame.split(/\r?\n/).forEach(line => {
          if (line.startsWith('event:')) event = line.slice(6).trimStart();
          if (line.startsWith('data:')) data.push(line.slice(5).trimStart());
        });
        return { event, data: data.join('\n') };
      }

      function processEvent(frame) {
        if (!frame.trim()) return undefined;
        const item = readEvent(frame);
        if (item.event === 'heartbeat') return undefined;
        if (item.event === 'progress') {
          onProgress(JSON.parse(item.data));
          return undefined;
        }
        if (item.event === 'result') return JSON.parse(item.data);
        if (item.event === 'error') {
          let message = item.data;
          try {
            message = JSON.parse(item.data).message ?? message;
          } catch {
          }
          throw new Error(message || 'The evaluation failed.');
        }
        return undefined;
      }

      while (true) {
        const { value, done } = await reader.read();
        buffer += decoder.decode(value ?? new Uint8Array(), { stream: !done });

        while (true) {
          const separator = buffer.match(/\r?\n\r?\n/);
          if (!separator) break;
          const result = processEvent(buffer.slice(0, separator.index));
          if (result !== undefined) return result;
          buffer = buffer.slice(separator.index + separator[0].length);
        }

        if (done) break;
      }

      const result = processEvent(buffer);
      if (result !== undefined) return result;
      throw new Error('The response stream ended before a result was received.');
    }
  </script>
}
