@page "/courses/{courseId}/evaluation"
@model CurriculumPortal.CourseEvaluationModel
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@{
  ViewData["Title"] = $"{Model.Course.Name} Evaluation";
}

@functions {
  static IEnumerable<string> Clean(IEnumerable<string> items) =>
    (items ?? Enumerable.Empty<string>()).Where(o => !string.IsNullOrWhiteSpace(o));

  static bool HasItems(IEnumerable<string> items) => Clean(items).Any();

  static string RatingClass(string rating) =>
    (rating ?? string.Empty).ToLowerInvariant().Replace(" ", "-", StringComparison.Ordinal);
}

@section Head {
  <link rel="stylesheet" href="/css/curriculum.css" />
}

<div id="curriculum-app" class="evaluation-app">
  <main class="evaluation-main active">
    <div class="evaluation-header">
      <a class="back-button" href="/courses/@Uri.EscapeDataString(Model.CourseId)" title="Back to course" aria-label="Back to course">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      </a>
      <div class="evaluation-heading">
        <span class="evaluation-kicker">Course evaluation</span>
        <h2>@Model.Course.Name</h2>
        @if (Model.Evaluation is not null)
        {
          <p>Generated @Model.GeneratedAtText</p>
        }
      </div>
      @if (Model.IsAdmin)
      {
        <button id="evaluate-course" class="evaluation-action">
          <span class="material-symbols-outlined">emoji_objects</span>
          <span>Evaluate this course</span>
        </button>
      }
    </div>

    @if (Model.Evaluation is null)
    {
      <section class="evaluation-empty">
        <span class="material-symbols-outlined">draft</span>
        <h3>No evaluation is available.</h3>
        <p>Run an evaluation to generate structured feedback for this course.</p>
      </section>
    }
    else
    {
      var ratings = new[] { "Excellent", "Broadly Good", "Moderate Issues", "Serious Issues" };
      var ratingCounts = ratings.ToDictionary(r => r, r => 0, StringComparer.OrdinalIgnoreCase);
      var evaluationRatings = new[]
      {
        Model.Evaluation.Overall.SequencingRating,
        Model.Evaluation.Overall.CoverageBalanceRating
      }.Concat(Model.Evaluation.Units.SelectMany(unit => new[]
      {
        unit.KeyKnowledge.Rating,
        unit.AssessmentAlignment.Rating,
        unit.AssessmentDesign.Rating
      }));

      foreach (var rating in evaluationRatings.Where(rating => ratingCounts.ContainsKey(rating)))
      {
        ratingCounts[rating]++;
      }

      <section class="evaluation-summary-section">
        <div class="evaluation-section-header">
          <h3>Summary</h3>
        </div>
        <p class="evaluation-summary">These evaluations have been generated by AI and may not accurately reflect the true quality of the course. Use your own judgement when reviewing the feedback and prioritising improvements.</p>
        <div class="evaluation-rating-summary">
          @foreach (var rating in ratings)
          {
            <article class="evaluation-rating-box">
              <span>@ratingCounts[rating]</span>
              <span aria-hidden="true">&times;</span>
              <span class="evaluation-rating rating-@RatingClass(rating)" role="img" aria-label="@rating"></span>
              <span>@rating.Replace("Broadly ", string.Empty)</span>
            </article>
          }
        </div>
      </section>

      <section class="evaluation-overview">
        <div class="evaluation-section-header">
          <h3>Curriculum Overview</h3>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Evaluation.Overall.Summary))
        {
          <p class="evaluation-summary">@Model.Evaluation.Overall.Summary</p>
        }
        <div class="evaluation-grid">
          <article class="evaluation-panel">
            <div class="evaluation-title-row">
              <span class="evaluation-rating rating-@RatingClass(Model.Evaluation.Overall.SequencingRating)" role="img" aria-label="@Model.Evaluation.Overall.SequencingRating"></span>
              <h4>Sequencing</h4>
            </div>
            @if (HasItems(Model.Evaluation.Overall.SequencingIssues))
            {
              <ul>
                @foreach (var item in Clean(Model.Evaluation.Overall.SequencingIssues))
                {
                  <li>@item</li>
                }
              </ul>
            }
          </article>
          <article class="evaluation-panel">
            <div class="evaluation-title-row">
              <span class="evaluation-rating rating-@RatingClass(Model.Evaluation.Overall.CoverageBalanceRating)" role="img" aria-label="@Model.Evaluation.Overall.CoverageBalanceRating"></span>
              <h4>Coverage and balance</h4>
            </div>
            @if (HasItems(Model.Evaluation.Overall.CoverageBalanceIssues))
            {
              <ul>
                @foreach (var item in Clean(Model.Evaluation.Overall.CoverageBalanceIssues))
                {
                  <li>@item</li>
                }
              </ul>
            }
          </article>
        </div>
      </section>

      <div class="evaluation-units">
        @foreach (var unit in Model.Evaluation.Units)
        {
          <section class="evaluation-unit">
            <h3>@unit.Title</h3>
            <div class="evaluation-criteria">
              <article class="evaluation-criterion">
                <div class="evaluation-criterion-header">
                  <div class="evaluation-title-row">
                    <span class="evaluation-rating rating-@RatingClass(unit.KeyKnowledge.Rating)" role="img" aria-label="@unit.KeyKnowledge.Rating"></span>
                    <h4>Key knowledge</h4>
                  </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(unit.KeyKnowledge.Overview))
                {
                  <h5>Overview</h5>
                  <p>@unit.KeyKnowledge.Overview</p>
                }
                @if (HasItems(unit.KeyKnowledge.SpecificityAccuracyIssues))
                {
                  <h5>Specificity and accuracy</h5>
                  <ul>
                    @foreach (var item in Clean(unit.KeyKnowledge.SpecificityAccuracyIssues))
                    {
                      <li>@item</li>
                    }
                  </ul>
                }
                @if (HasItems(unit.KeyKnowledge.MissingOrVagueKnowledge))
                {
                  <h5>Missing or vague knowledge</h5>
                  <ul>
                    @foreach (var item in Clean(unit.KeyKnowledge.MissingOrVagueKnowledge))
                    {
                      <li>@item</li>
                    }
                  </ul>
                }
              </article>

              <article class="evaluation-criterion">
                <div class="evaluation-criterion-header">
                  <div class="evaluation-title-row">
                    <span class="evaluation-rating rating-@RatingClass(unit.AssessmentAlignment.Rating)" role="img" aria-label="@unit.AssessmentAlignment.Rating"></span>
                    <h4>Assessment alignment</h4>
                  </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(unit.AssessmentAlignment.NotApplicableReason))
                {
                  <p class="evaluation-note">@unit.AssessmentAlignment.NotApplicableReason</p>
                }
                @if (HasItems(unit.AssessmentAlignment.AlignedCoverage))
                {
                  <h5>Coverage of key knowledge</h5>
                  <ul>
                    @foreach (var item in Clean(unit.AssessmentAlignment.AlignedCoverage))
                    {
                      <li>@item</li>
                    }
                  </ul>
                }
                @if (HasItems(unit.AssessmentAlignment.GapsOrMisalignments))
                {
                  <h5>Key knowledge gaps</h5>
                  <ul>
                    @foreach (var item in Clean(unit.AssessmentAlignment.GapsOrMisalignments))
                    {
                      <li>@item</li>
                    }
                  </ul>
                }
              </article>

              <article class="evaluation-criterion">
                <div class="evaluation-criterion-header">
                  <div class="evaluation-title-row">
                    <span class="evaluation-rating rating-@RatingClass(unit.AssessmentDesign.Rating)" role="img" aria-label="@unit.AssessmentDesign.Rating"></span>
                    <h4>Assessment design</h4>
                  </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(unit.AssessmentDesign.NotApplicableReason))
                {
                  <p class="evaluation-note">@unit.AssessmentDesign.NotApplicableReason</p>
                }
                @if (!string.IsNullOrWhiteSpace(unit.AssessmentDesign.Overview))
                {
                  <h5>Overview</h5>
                  <p>@unit.AssessmentDesign.Overview</p>
                }
                @if (HasItems(unit.AssessmentDesign.DesignIssues))
                {
                  <h5>Design</h5>
                  <ul>
                    @foreach (var item in Clean(unit.AssessmentDesign.DesignIssues))
                    {
                      <li>@item</li>
                    }
                  </ul>
                }
              </article>
            </div>
          </section>
        }
      </div>
    }
  </main>
</div>

<div id="modal" class="evaluation-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div id="modal-content">
    <div id="modal-body">
      <h2 id="modal-title"><span class="spinner"></span><span>Evaluating the course...</span></h2>
      <p class="evaluation-progress-note">This may take several minutes. Do not close the page.</p>
      <div class="evaluation-progress-track" role="progressbar" aria-label="Evaluation progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="evaluation-progress-bar"></div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    const courseId = @Html.Raw(JsonSerializer.Serialize(Model.CourseId));
    const csrfToken = @Html.Raw(JsonSerializer.Serialize(Model.CsrfToken));
    const elements = {
      evaluate: document.getElementById('evaluate-course'),
      modal: document.getElementById('modal'),
      progressTrack: document.querySelector('.evaluation-progress-track'),
      progressBar: document.getElementById('evaluation-progress-bar')
    };

    elements.evaluate?.addEventListener('click', evaluateCourse);

    function setProgress(percentage) {
      const value = Math.max(0, Math.min(Number(percentage) || 0, 100));
      elements.progressBar.style.width = `${value}%`;
      elements.progressTrack.setAttribute('aria-valuenow', String(value));
    }

    async function evaluateCourse() {
      elements.evaluate.disabled = true;
      setProgress(0);
      elements.modal.classList.add('active');

      try {
        await postSse(`/courses/${encodeURIComponent(courseId)}/evaluate`, progress => {
          setProgress(progress.percentage ?? 0);
        });
        setProgress(100);
        window.location.reload();
      } catch (error) {
        const message = error.message || 'The evaluation failed.';
        elements.modal.classList.remove('active');
        window.alert(message);
        elements.evaluate.disabled = false;
      }
    }

    async function postSse(url, onProgress) {
      if (!csrfToken) {
        throw new Error('Missing anti-forgery token.');
      }

      const response = await fetch(url, {
        method: 'POST',
        headers: { 'X-CSRF-TOKEN': csrfToken }
      });
      if (!response.ok) throw new Error(await response.text());
      if (!response.body) throw new Error('No response stream received.');

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      function readEvent(frame) {
        let event = 'message';
        const data = [];
        frame.split(/\r?\n/).forEach(line => {
          if (line.startsWith('event:')) event = line.slice(6).trimStart();
          if (line.startsWith('data:')) data.push(line.slice(5).trimStart());
        });
        return { event, data: data.join('\n') };
      }

      function processEvent(frame) {
        if (!frame.trim()) return undefined;
        const item = readEvent(frame);
        if (item.event === 'heartbeat') return undefined;
        if (item.event === 'progress') {
          onProgress(JSON.parse(item.data));
          return undefined;
        }
        if (item.event === 'result') return JSON.parse(item.data);
        if (item.event === 'error') {
          let message = item.data;
          try {
            message = JSON.parse(item.data).message ?? message;
          } catch {
          }
          throw new Error(message || 'The evaluation failed.');
        }
        return undefined;
      }

      while (true) {
        const { value, done } = await reader.read();
        buffer += decoder.decode(value ?? new Uint8Array(), { stream: !done });

        while (true) {
          const separator = buffer.match(/\r?\n\r?\n/);
          if (!separator) break;
          const result = processEvent(buffer.slice(0, separator.index));
          if (result !== undefined) return result;
          buffer = buffer.slice(separator.index + separator[0].length);
        }

        if (done) break;
      }

      const result = processEvent(buffer);
      if (result !== undefined) return result;
      throw new Error('The response stream ended before a result was received.');
    }
  </script>
}
