@using CurriculumPortal
@inject AppOptions AppOptions
@inject ConfigService Config
@inject XpService Xp
@inject ILoggerFactory LoggerFactory
@{
  var title = ViewData["Title"] as string;
  var resolvedTitle = string.IsNullOrWhiteSpace(title) ? AppOptions.SchoolName : title;
  var siteName = $"{AppOptions.SchoolName} Curriculum Portal";
  var metaDescription = ViewData["MetaDescription"] as string;
  var metaImage = ViewData["MetaImage"] as string;
  var canonicalUrl = ViewData["CanonicalUrl"] as string;
  var robots = ViewData["Robots"] as string;
  var isCoursesSection = Context.Request.Path.StartsWithSegments("/courses");
  var isAssignmentsSection = Context.Request.Path.StartsWithSegments("/assignments") || Context.Request.Path.StartsWithSegments("/bonus-quiz");
  var bodyClass = isAssignmentsSection ? "assignments-layout" : string.Empty;
  var pageBodyClass = ViewData["BodyClass"] as string;
  if (!string.IsNullOrWhiteSpace(pageBodyClass))
    bodyClass = string.IsNullOrWhiteSpace(bodyClass) ? pageBodyClass : $"{bodyClass} {pageBodyClass}";
  var returnUrl = Uri.EscapeDataString($"{Context.Request.Path}{Context.Request.QueryString}");
  var studentRank = string.Empty;
  if (User.Identity.IsAuthenticated && User.IsInRole(Roles.Student) && Config.UsersByEmail.TryGetValue(User.GetEmail(), out var student))
  {
    try
    {
      studentRank = (await Xp.GetProgressAsync(student.Id, DateTimeOffset.UtcNow, Context.RequestAborted)).CurrentRank;
    }
    catch (Exception ex) when (!Context.RequestAborted.IsCancellationRequested)
    {
      LoggerFactory.CreateLogger("CurriculumPortal.Pages.Shared.Layout").LogWarning(ex, "Failed to load the navigation rank for student {StudentId}.", student.Id);
    }
  }
  var rankImage = $"/images/ranks/{studentRank.ToLowerInvariant()}";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@resolvedTitle</title>
  <meta property="og:site_name" content="@siteName" />
  <script type="application/ld+json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
      ["@context"] = "https://schema.org",
      ["@type"] = "WebSite",
      ["name"] = siteName,
      ["url"] = $"{AppOptions.Website.TrimEnd('/')}/"
    }))
  </script>
  @if (!string.IsNullOrWhiteSpace(metaDescription))
  {
    <meta name="description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@resolvedTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(metaImage) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@resolvedTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    @if (!string.IsNullOrWhiteSpace(metaImage))
    {
      <meta property="og:image" content="@metaImage" />
      <meta name="twitter:image" content="@metaImage" />
    }
  }
  @if (!string.IsNullOrWhiteSpace(canonicalUrl))
  {
    <link rel="canonical" href="@canonicalUrl" />
  }
  @if (!string.IsNullOrWhiteSpace(robots))
  {
    <meta name="robots" content="@robots" />
  }
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=block" />
  <link rel="stylesheet" href="/css/layout.css" asp-append-version="true" />
  @RenderSection("Head", required: false)
</head>

<body class="@bodyClass">
  <header class="app-header" style="--brand-colour: @AppOptions.BrandColour; --brand-accent-colour: @AppOptions.BrandAccentColour;">
    <div class="header-bar" data-nosnippet>
      <details class="nav-menu">
        <summary class="nav-menu-toggle" aria-label="Toggle navigation menu">
          <span></span>
          <span></span>
          <span></span>
        </summary>
        <nav class="nav-menu-panel" aria-label="Main navigation">
          @if (User.Identity.IsAuthenticated)
          {
            <a class="nav-drawer-link @(isCoursesSection ? "active" : string.Empty)" href="/courses">Courses</a>
            <a class="nav-drawer-link @(isAssignmentsSection ? "active" : string.Empty)" href="/assignments">Assignments</a>
            <span class="nav-drawer-user">
              @if (studentRank.Length > 0)
              {
                <img class="nav-rank-badge" src="@(rankImage)-64.webp" srcset="@(rankImage)-64.webp 64w, @(rankImage)-128.webp 128w" sizes="28px" width="28" height="28" alt="@studentRank rank" title="@studentRank" />
              }
              <span class="user-display-name">@User.GetDisplayName()</span>
            </span>
            <a class="nav-drawer-link" href="/logout">Sign Out</a>
          }
          else
          {
            <a class="nav-drawer-link" href="/login?path=@returnUrl">Sign In</a>
          }
        </nav>
      </details>
      <div class="brand-heading">
        <a class="navbar-brand" href="/courses">
          <img class="navbar-logo" src="/images/school-logo-navbar.png" alt="@AppOptions.SchoolName logo" width="100" height="100">
          <span>Curriculum Portal</span>
        </a>
      </div>
      @if (User.Identity.IsAuthenticated)
      {
        <nav class="nav-links" aria-label="Main navigation">
          <a class="nav-link @(isCoursesSection ? "active" : string.Empty)" href="/courses">Courses</a>
          <a class="nav-link @(isAssignmentsSection ? "active" : string.Empty)" href="/assignments">Assignments</a>
        </nav>
      }
      <div class="auth-actions">
        @if (User.Identity.IsAuthenticated)
        {
          <span class="signed-in-name">
            @if (studentRank.Length > 0)
            {
              <img class="nav-rank-badge" src="@(rankImage)-64.webp" srcset="@(rankImage)-64.webp 64w, @(rankImage)-128.webp 128w" sizes="28px" width="28" height="28" alt="@studentRank rank" title="@studentRank" />
            }
            <span class="user-display-name">@User.GetDisplayName()</span>
          </span>
          <a class="auth-button auth-link" href="/logout">Sign Out</a>
        }
        else
        {
          <a class="auth-button" href="/login?path=@returnUrl">Sign In</a>
        }
      </div>
    </div>
  </header>

  @RenderSection("SubHeader", required: false)

  <div class="app-body">
    @RenderBody()
  </div>

  <footer class="app-footer">
    <a href="/privacy">Privacy Policy</a>
  </footer>

  <script src="/js/layout.js"></script>
  @RenderSection("Scripts", required: false)
</body>

</html>
