@page "/bonus-quiz"
@model CurriculumPortal.BonusQuizModel

@section Head {
  <link rel="stylesheet" href="/css/assignments.css" />
}

<div id="assignments-app" class="assignments-page">
  <div class="assignments-shell">
    <section class="assignment-detail assignment-play">
      <header class="assignment-detail-header assignment-play-header">
        <div>
          <h2 class="assignment-play-title">Bonus quiz</h2>
          <p class="assignment-play-meta">Get every question right to earn XP</p>
        </div>
      </header>
      <div id="assignment-detail-root" class="assignment-play-body">
        <p class="assignments-empty">Loading bonus quiz...</p>
      </div>
    </section>
  </div>

  <div id="csrf"><input type="hidden" name="__RequestVerificationToken" value="@Model.CsrfToken" /></div>
</div>

@section Scripts {
  <script>
    const assignmentDetailData = @Html.Raw(Model.PageDataJson);
    const assignmentSubmitUrl = "/bonus-quiz/submit";
    const assignmentQuizConfig = {
      mode: "bonus",
      completeTitle: "Bonus quiz complete",
      completeText: "Perfect run complete.",
      backHref: "/assignments",
      backLabel: "Back to assignments"
    };
    window.MathJax = window.MathJax ?? {
      tex: { inlineMath: [['`', '`']], displayMath: [['$$', '$$']] },
      output: {
        displayOverflow: 'scroll',
        font: 'mathjax-newcm',
        fontPath: `${location.origin}/lib/mathjax-newcm-font`
      },
      options: {
        worker: {
          path: `${location.origin}/lib/mathjax/sre`,
          maps: `${location.origin}/lib/mathjax/sre/mathmaps`,
          worker: 'speech-worker.js'
        }
      }
    };
  </script>
  <script src="/lib/mathjax/tex-chtml.min.js"></script>
  <script src="/js/assignment-detail.js"></script>
}
