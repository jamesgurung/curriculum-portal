{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "mathjax@4.1.3",
      "destination": "wwwroot/lib/mathjax/",
      "files": [
        "tex-chtml.min.js",
        "sre/speech-worker.js",
        "sre/mathmaps/base.json",
        "sre/mathmaps/en.json",
        "sre/mathmaps/nemeth.json"
      ]
    },
    {
      "library": "@mathjax/mathjax-newcm-font@4.1.3",
      "destination": "wwwroot/lib/mathjax-newcm-font/",
      "files": [
        "chtml/woff2/mjx-ncm-brk.woff2",
        "chtml/woff2/mjx-ncm-c.woff2",
        "chtml/woff2/mjx-ncm-ds.woff2",
        "chtml/woff2/mjx-ncm-em.woff2",
        "chtml/woff2/mjx-ncm-lo.woff2",
        "chtml/woff2/mjx-ncm-n.woff2",
        "chtml/woff2/mjx-ncm-s5.woff2",
        "chtml/woff2/mjx-ncm-s6.woff2",
        "chtml/woff2/mjx-ncm-zero.woff2"
      ]
    },
    {
      "library": "sortablejs@1.15.7",
      "destination": "wwwroot/lib/sortablejs/",
      "files": [
        "Sortable.min.js"
      ]
    },
    {
      "library": "pagedjs@0.4.3",
      "destination": "wwwroot/lib/pagedjs/",
      "files": [
        "dist/paged.polyfill.js"
      ]
    }
  ]
}
